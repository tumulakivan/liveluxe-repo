{
  "name": "listing-repo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter @repo/web build",
    "start": "node apps/api/src/index.ts",
    "sync": "pnpm --filter @repo/api sync",
    "typecheck": "pnpm -r typecheck",
    "admin": "pnpm --silent --filter @repo/api admin",
    "fill:import": "pnpm --silent --filter @repo/api fill:import"
  }
}
