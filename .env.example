# Copy to .env for local use. On Railway, set these as service variables instead. Never commit real values.

# Hostaway public API (Sync Hostaway)
HOSTAWAY_ACCT_ID=
HOSTAWAY_API_KEY=

# Railway sets PORT itself; locally the API runs on 4200.
PORT=4200

# true behind HTTPS (Railway). Leave unset for http://localhost.
COOKIE_SECURE=

# Optional: where the database and uploaded photos live (default data/ in the repo; /app/data on Railway).
DB_FILE=
PHOTOS_DIR=

# Only for `pnpm fill:import`: an access token (Dashboard → Accounts → Access tokens) and the API to send to.
LISTING_REPO_TOKEN=
FILL_API_URL=
